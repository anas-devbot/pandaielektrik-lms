# Salin ke .env.local (local) atau /etc/pandaielektrik/env (VPS). JANGAN commit nilai sebenar.
# Pembolehubah NEXT_PUBLIC_* masuk bundle klien: hanya nilai awam.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server sahaja (CLAUDE.md peraturan #5). Jangan awali dengan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Bayarcash: nama tepat ikut /docs-ref selepas dokumentasi diterima (slice 0). Placeholder sahaja.
# BAYARCASH_...=

# R2 private (PDF, borang, skematik). Akaun atas nama AHZ.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Backup (scripts/backup.sh). Bucket SEPARA dari bucket PDF/penghantaran; private. Kunci R2 kongsi akaun, token sebaiknya terhad pada bucket.
BACKUP_DATABASE_URL=…
R2_BACKUP_BUCKET=…
